_normal_menu_rule () {
   local _text="$1" _fill _remaining
   _remaining=$((_normal_menu_cols - 2 - ${#_text} - 2))
   printf '  \033[1;36m%s\033[0m' "$_text"
   if (( _remaining > 0 )); then
      printf '  \033[0;34m'
      printf -v _fill '%*s' "$_remaining" ''
      printf '%s\033[0m' "${_fill// /─}"
   fi
   printf '\n'
}
_normal_menu_card_border () {
   local _left="$1" _right="$2" _rule _i
   printf '  %s' "$_left"
   printf -v _rule '%*s' "$_normal_menu_card_width" ''
   _rule=${_rule// /─}
   for ((_i=0; _i<3; _i++)); do
      printf '%s%s' "$_rule" "$_right"
      (( _i < 2 )) && printf ' %s' "$_left"
   done
   printf '\n'
}
_normal_menu_card_cell () {
   local _value="${1:0:$2}" _width="$2" _color="$3"
   printf '%b%-*s\033[0m' "$_color" "$_width" "$_value"
}
_normal_menu_card_row () {
   local _color="$1"
   printf '  │'
   _normal_menu_card_cell "$2" "$_normal_menu_card_width" "$_color"
   printf '│ │'
   _normal_menu_card_cell "$3" "$_normal_menu_card_width" "$_color"
   printf '│ │'
   _normal_menu_card_cell "$4" "$_normal_menu_card_width" "$_color"
   printf '│\n'
}
_normal_menu_single_border () {
   local _corner="$1" _rule
   printf -v _rule '%*s' "$((_normal_menu_cols - 4))" ''
   printf '  %s%s%s\n' "$_corner" "${_rule// /─}" "$_corner"
}
_normal_menu_single_row () {
   local _text="${1:0:$((_normal_menu_cols - 4))}" _color="$2"
   printf '  │%b%-*s\033[0m│\n' "$_color" "$((_normal_menu_cols - 4))" "$_text"
}
_normal_menu_input () {
   local _rule _plain _hint='' _pad _inner
   _inner=$((_normal_menu_cols - 4))
   printf -v _rule '%*s' "$_inner" ''
   printf '\n  ┌%s┐\n' "${_rule// /─}"
   _plain=' NE YAPMAK İSTERSİNİZ?  [   ]'
   _hint='Seçim numarasını yazıp Enter’a basın'
   if (( _normal_menu_cols >= 100 && ${#_plain} + ${#_hint} + 2 <= _inner )); then
      _pad=$((_inner - ${#_plain} - ${#_hint}))
      printf '  │ \033[1;32mNE YAPMAK İSTERSİNİZ?\033[0m  \033[1;36m[   ]\033[0m%*s\033[0;37m%s\033[0m│\n' "$_pad" '' "$_hint"
   else
      _pad=$((_inner - ${#_plain}))
      printf '  │ \033[1;32mNE YAPMAK İSTERSİNİZ?\033[0m  \033[1;36m[   ]\033[0m%*s│\n' "$_pad" ''
   fi
   printf '  └%s┘\n' "${_rule// /─}"
   printf '  \033[1;36m›\033[0m '
}
_normal_menu_option_cell () {
   local _index="$1" _width="$2" _number="${_normal_menu_numbers[$1]}"
   local _label="${_normal_menu_labels[$1]}" _state='' _state_plain='' _state_color=''
   local _plain _pad _max_label
   case "$_index" in
      15) _state="$stsl" ;;
      16) _state="$stsu" ;;
   esac
   case "$_state" in
      *'◉'*) _state_plain=' ●'; _state_color='\033[1;32m●\033[0m' ;;
      *'○'*) _state_plain=' ○'; _state_color='\033[1;31m○\033[0m' ;;
   esac
   _plain="[$_number] $_label$_state_plain"
   if (( ${#_plain} > _width )); then
      _max_label=$((_width - 4 - ${#_number} - ${#_state_plain}))
      (( _max_label < 0 )) && _max_label=0
      _label=${_label:0:_max_label}
      _plain="[$_number] $_label$_state_plain"
   fi
   printf '\033[1;36m[%s]\033[0m \033[1;33m%s\033[0m' "$_number" "$_label"
   [[ -n "$_state_color" ]] && printf ' %b' "$_state_color"
   _pad=$((_width - ${#_plain}))
   (( _pad > 0 )) && printf '%*s' "$_pad" ''
}
